<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_rag_outbox_flush" model="ir.cron">
            <field name="name">RAG: publish pending outbox messages</field>
            <field name="model_id" ref="model_rag_outbox"/>
            <field name="state">code</field>
            <field name="code">model._cron_flush()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_rag_stock_sync" model="ir.cron">
            <field name="name">RAG: sync stock changes</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="state">code</field>
            <field name="code">model._cron_rag_sync_stock()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_rag_reconcile" model="ir.cron">
            <field name="name">RAG: reconcile index (remove orphan products)</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="state">code</field>
            <field name="code">model._cron_rag_reconcile()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>